{
  "manifest_version": 3,
  "name": "ToolBot Stake Hunt",
  "version": "1.0.1",
  "description": "Adds your unfinished Stake bets to your ToolBot bonus hunt, and shows the slot you have open.",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["stake-main.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["stake.js"], "run_at": "document_start" },
    { "matches": ["https://toolbott.pages.dev/*"], "js": ["site.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "ToolBot Stake Hunt" },
  "icons": { "128": "icon.png" }
}
